# ============================================================
# Deep Research Agent Platform - Environment Configuration
# ============================================================
# 复制此文件为 .env 并填入你的 API Key
# cp .env.example .env

# ============================================================
# 🔑 LLM API 配置
# ============================================================
# 支持任意 OpenAI-compatible API

# --- OpenAI 官方 ---
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# --- DeepSeek（推荐，性价比高）---
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# --- 阿里通义千问 ---
# OPENAI_API_KEY=sk-your-qwen-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-max

# --- 月之暗面 Kimi ---
# OPENAI_API_KEY=sk-your-moonshot-key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# --- 智谱 GLM ---
# OPENAI_API_KEY=your-zhipu-key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4

# --- 本地模型（Ollama）---
# OPENAI_API_KEY=not-needed
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ============================================================
# 🗄️ 数据库
# ============================================================
DATABASE_URL=sqlite:///./data/research.db

# ============================================================
# 🔍 检索与数据
# ============================================================

# Web Search 后端：mock | serper | tavily | brave
SEARCH_API_TYPE=mock
# 真实 API Key（可选）:
# SERPER_API_KEY=your-serper-key      https://serper.dev
# TAVILY_API_KEY=your-tavily-key      https://tavily.com
# BRAVE_API_KEY=your-brave-key        https://brave.com/search/api/

# 向量数据库：faiss | milvus | qdrant
VECTOR_STORE_TYPE=faiss
# Milvus: docker run -d -p 19530:19530 milvusdb/milvus:latest
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# Qdrant: docker run -d -p 6333:6333 qdrant/qdrant
# QDRANT_URL=http://localhost:6333

# 金融数据：mock | tushare | akshare
FINANCIAL_API_TYPE=mock
# TUSHARE_TOKEN=your-tushare-token    https://tushare.pro
# AKShare: pip install akshare (免费，无需 Key)

# ============================================================
# ⚙️ 其他
# ============================================================
EXPORT_DIR=./data/exports
MAX_ITERATIONS=3
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SANDBOX_DIR=./data/sandbox
ALLOWED_IMPORTS=pandas,numpy,matplotlib,json,math,statistics
